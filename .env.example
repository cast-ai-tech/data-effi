# =============================================================================
# Master Data - environment template
#
# Copy to .env and fill EVERY blank. The API refuses to start if a required
# variable is missing, and it tells you exactly which one.
#   cp .env.example .env
#
# NEVER commit .env. NEVER paste a real secret into this file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# The database, its roles (norte_app, norte_readonly) and the session variables
# keep the old internal name on purpose: they are baked into ten applied
# migrations and every mart view, and renaming them buys nothing a user can
# see while costing a migration and a database rebuild.
# The superuser owns the schema and runs migrations. The application NEVER
# connects with it: PostgreSQL exempts superusers from row-level security, so an
# app running as one silently bypasses every tenant policy.
POSTGRES_USER=norte
POSTGRES_PASSWORD=            # required - generate one, e.g. openssl rand -hex 24
POSTGRES_DB=norte
POSTGRES_PORT=5433            # host port; container always listens on 5432
POSTGRES_ADMIN_URL=postgresql://norte:CHANGE_ME@localhost:5433/norte

# What the API and worker actually use. Subject to row-level security.
POSTGRES_APP_PASSWORD=        # required - openssl rand -hex 24
# Where the API reads and writes.
#   - Empty: Docker uses its own `db` container (norte_app, password above).
#   - Supabase/other: paste the full URL and Docker AND the local API use it;
#     migrations are then NOT applied on start (production is migrated by hand).
#   - Running the API outside Docker against the local container:
#     postgresql://norte_app:CHANGE_ME@localhost:5433/norte
DATABASE_URL=

# Read-only role used ONLY by the NL->SQL layer. search_path = mart, 5s timeout.
POSTGRES_READONLY_PASSWORD=   # required once the AI layer is enabled
# Empty = the NL->SQL layer is off. Same rules as DATABASE_URL.
DATABASE_URL_READONLY=

# --- Security ---------------------------------------------------------------
# Signing key for access/refresh JWTs. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Salt for hashing customer phone/document. Generate: openssl rand -hex 32
# CHANGING THIS ORPHANS EVERY EXISTING customer_hash. Treat it as permanent.
PII_HASH_SALT=

# Shared secret for POST /worker/trigger/{job}. Generate: openssl rand -hex 32
WORKER_TRIGGER_SECRET=

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# "production" turns on HSTS and hides /docs, /redoc and /openapi.json.
# Anything else is treated as a developer machine.
ENVIRONMENT=development
# Where uploaded files wait to be processed. Ephemeral is fine: raw rows live
# in the database once a load finishes.
UPLOAD_DIR=uploads
DB_POOL_MIN=1
DB_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
# Optional regex for origins that change with every deploy (Vercel previews).
# Production: ^https://masterdataweb(-[a-z0-9-]+)?\.vercel\.app$  (see render.yaml)
CORS_ORIGIN_REGEX=

# Origin an OUTSIDE caller uses to reach this API - what n8n, Make or Zapier will
# POST to. REQUIRED IN PRODUCTION: behind a proxy the request's own host is the
# internal one, and the webhook URL Master Data hands the operator is shown exactly
# once. Leave empty in local development.
#   PUBLIC_API_URL=https://api.tu-dominio.com
PUBLIC_API_URL=
# Believe X-Forwarded-For (rate limiting, audit IPs). true behind Render or any
# reverse proxy; false if clients reach the API directly.
TRUST_PROXY_HEADERS=true
# Shared between the API and the web server's proxy (web/app/api/backend), so
# the API can tell the real browser address apart from the proxy's. Generate
# one value and set it in BOTH deployments: openssl rand -hex 32
PROXY_SHARED_SECRET=
MAX_UPLOAD_MB=25
INGEST_MAX_CONCURRENCY=4
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=30
LOG_LEVEL=INFO

# --- AI layer ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. It is a secret: it goes in
# .env and NEVER in this file, in a commit, or in a screenshot.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_DAILY_TOKEN_BUDGET=200000
AI_REQUEST_TIMEOUT_SECONDS=45
# Cap on reasoning tokens per call. Gemini 3.x refuses 0; 128 keeps short
# answers short without cutting them off.
AI_THINKING_BUDGET=128
AI_ENABLED=false              # set true only after GEMINI_API_KEY is filled

# --- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
# Tasas oficiales que SÍ exigen credencial. Ambas son gratuitas y, sin
# ellas, esas dos monedas caen al proveedor internacional sin romper nada.
#   Banxico (México): se saca en banxico.org.mx/SieAPIRest
#   BCCR (Costa Rica): se pide por correo y llega junto al correo registrado
BANXICO_TOKEN=
BCCR_TOKEN=
BCCR_EMAIL=

FX_PROVIDER_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies
FX_PROVIDER_API_KEY=          # optional, depends on the provider you choose
TIER3_FETCH_ENABLED=false     # keep false until consent is recorded per connection

# --- Credential vault (migration 051) ---------------------------------------
# Lets a merchant connect their own Effi account from the settings screen: their
# username and password are encrypted with this key before they touch a row.
#
# Generate one with:   python -m scripts.generate_vault_key
#
# SEPARATE from PII_ENCRYPTION_KEY on purpose. Rotating the PII key must not
# invalidate every merchant's platform password, and a code path that can read a
# customer's phone number must not also be able to read a password.
#
# Empty is a valid state: the connection screen then says the vault is not
# configured and everyone keeps uploading the report by hand, which produces the
# identical dashboard. Losing this key is recoverable - each merchant re-enters
# their credential once - but nothing decrypts until they do.
CONNECTION_VAULT_KEY=

# Effi's login shape, overridable without a deploy because it is the part most
# likely to change on their side. Leave every one of these empty until the login
# has been verified against a real Effi account - see connectors/effi/auth.py,
# which refuses to log in at all until LOGIN_CONTRACT_VERIFIED is flipped.
EFFI_BASE_URL=
EFFI_LOGIN_PATH=
EFFI_LOGIN_USER_FIELD=
EFFI_LOGIN_PASS_FIELD=
EFFI_SESSION_CARRIER=         # cookie | json
EFFI_SESSION_COOKIE=
EFFI_TOKEN_JSON_KEY=
EFFI_LOGIN_CSRF_FIELD=        # empty when Effi's login needs no CSRF token

# --- Plans ------------------------------------------------------------------
# WhatsApp number of the advisor who activates plans and builds the custom
# ones. Country code, digits only (573001234567). Empty hides the button on
# the plans screen.
ADVISOR_WHATSAPP=

# --- Frontend ---------------------------------------------------------------
# The API's PUBLIC origin. The browser never calls it directly any more (the
# web server proxies every request), but the connections screen compares the
# webhook URL the API hands out against it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the web SERVER reaches the API. Inside docker compose that is the
# service name; on Vercel (or Netlify) it is the Render URL. Empty falls back to the value above.
API_URL=
PII_ENCRYPTION_KEY=
